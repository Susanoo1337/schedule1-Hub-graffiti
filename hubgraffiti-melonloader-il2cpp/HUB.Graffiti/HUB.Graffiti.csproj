<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build:  dotnet build -c Release -p:GamePath="D:\Steam\steamapps\common\Schedule I"
    GamePath must point at a Schedule I install that has MelonLoader (IL2CPP) and ModHub.Core installed,
    and the game must have been started once so MelonLoader generated MelonLoader\Il2CppAssemblies.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>HUB.Graffiti</AssemblyName>
    <RootNamespace>HUB.Graffiti</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Schedule I</GamePath>
    <MelonLoaderPath>$(GamePath)\MelonLoader</MelonLoaderPath>
    <!-- Set to true to copy the built DLL into the game's Mods folder after each build. -->
    <CopyToMods Condition="'$(CopyToMods)' == ''">false</CopyToMods>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderPath)\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderPath)\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderPath)\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ModHub.Core">
      <HintPath>$(GamePath)\Mods\ModHub.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Every generated interop assembly (Assembly-CSharp, UnityEngine.*, Il2CppTMPro, FishNet, Steamworks, ...). -->
    <Reference Include="$(MelonLoaderPath)\Il2CppAssemblies\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToModsFolder" AfterTargets="Build" Condition="'$(CopyToMods)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods" />
  </Target>

</Project>
